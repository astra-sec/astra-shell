[Unit]
Description=Astra Shell multi-user QUIC gateway
Documentation=https://github.com/astra-sec/astra-shell
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/mimi/astra-shell
Environment=RUST_LOG=astra_shell=info
ExecStart=/usr/local/sbin/astrad serve --managed --listen 0.0.0.0:4433 --state-dir /home/mimi/astra-shell/state --worker-idle-timeout-seconds 600
Restart=on-failure
RestartSec=2s

# Managed workers own the users' PTYs and deliberately outlive gateway restarts.
KillMode=process
TimeoutStopSec=10s

UMask=0077
# Authenticated workers provide SSH-like login shells, so their descendants must
# be able to run setuid tools such as sudo.
NoNewPrivileges=no
# The managed gateway must retain these capabilities so its Linux worker
# launcher can drop each child to the authenticated Unix account.
AmbientCapabilities=CAP_SETUID CAP_SETGID
# Keep the host's /tmp visible to those user sessions.
PrivateTmp=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
